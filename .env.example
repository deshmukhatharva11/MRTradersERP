# =============================================================
# MR Traders ERP — Environment Variables
# Copy this to .env and fill in your values
# DO NOT commit .env to Git
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=mrtraders_dev
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_secret_CHANGE_ME

# ── Odoo Ports ───────────────────────────────────────────────
ODOO_PORT=8069
ODOO_LONGPOLL_PORT=8072

# ── Odoo Master Password (admin panel) ───────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ODOO_ADMIN_PASSWD=mrtraders_master_pwd_CHANGE_ME

# ── Git Remotes ───────────────────────────────────────────────
# Set these before running git-setup.sh
# GIT_PRIVATE_REMOTE=git@github.com:YOUR_USERNAME/mr-traders-erp.git
