<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     MR Traders ERP — Company Branding Data
     Sets company name, logo reference, and initial config.
     ============================================================ -->
<odoo>
    <data noupdate="1">

        <!-- Update the default company with MR Traders branding -->
        <record id="base.main_company" model="res.company">
            <field name="name">MR Traders</field>
            <field name="website">https://mrtraders.pk</field>
            <!-- Logo: place your logo at static/src/img/mr_traders_logo.png
                 and update this field after first install via Settings > Companies -->
            <!-- <field name="logo" type="base64" file="mr_traders/static/src/img/mr_traders_logo.png"/> -->
        </record>

    </data>
</odoo>
