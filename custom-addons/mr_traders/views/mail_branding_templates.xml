<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="mr_traders_mail_notification_layout" inherit_id="mail.mail_notification_layout">
        <xpath expr="//div[@t-if='show_footer']//a[contains(@href, 'odoo.com')]" position="replace">
            <span t-att-style="'color: ' + (company.email_secondary_color or '#1a3c5e') + ';'">CodeZilla</span>
        </xpath>
    </template>

    <template id="mr_traders_mail_notification_light" inherit_id="mail.mail_notification_light">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span t-att-style="'color: ' + (company.email_secondary_color or '#1a3c5e') + ';'">CodeZilla</span>
        </xpath>
    </template>
</odoo>