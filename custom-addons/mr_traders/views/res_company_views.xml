<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     MR Traders ERP — Company View Extension
     ============================================================ -->
<odoo>
    <!-- Extend the company form to show MR Traders-specific fields -->
    <record id="view_company_form_mr_traders" model="ir.ui.view">
        <field name="name">res.company.form.mr.traders</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <field name="mr_traders_branch" placeholder="e.g. Karachi Main Branch"/>
            </xpath>
        </field>
    </record>
</odoo>
