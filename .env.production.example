# =============================================================
# MR Traders ERP — Production Environment Variables
# =============================================================
# Copy to .env.production and replace EVERY placeholder value.
# NEVER commit .env.production to Git.
#
# Generate secure passwords with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=mrtraders
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_LONG_DATABASE_PASSWORD

# ── Odoo ─────────────────────────────────────────────────────
ODOO_ADMIN_PASSWD=CHANGE_ME_LONG_ODOO_MASTER_PASSWORD

# ── Domain (your Cloudflare-proxied subdomain) ───────────────
ERP_DOMAIN=CHANGE_ME.mrtraders.site

# ── App Key (per-client desktop app authentication) ──────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# This MUST match the appKey in the client's client-config.json
# For multiple clients, use Cloudflare WAF rules or an Odoo addon
# to validate per-client keys.
APP_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# ── Backups ──────────────────────────────────────────────────
BACKUP_DIR=./backups
